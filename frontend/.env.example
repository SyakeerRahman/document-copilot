# Local development uses the Supabase stack from `supabase start` (run from the repo root).
# `supabase status -o env` prints the local anon key. For hosted Supabase: Dashboard -> Project Settings -> API.
# Only public (browser-safe) values belong here - never the service_role key or database URL.

# --- Backend API ---

VITE_API_BASE_URL=http://localhost:8000

# --- Supabase (browser auth) ---

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-public-key
