# Local development uses the Supabase stack from `supabase start` (run from the repo root).
# `supabase status -o env` prints the local values. For hosted Supabase:
#   Dashboard -> Project Settings -> API, and Project Settings -> Database -> Connection string.

# --- Supabase (Auth + API) ---

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) - migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Chat model ---

# ollama: local dev. Create the model first: ollama create qwen3-14b-16k -f backend/ollama/Modelfile
# openai: hosted. Requires OPENAI_API_KEY.
CHAT_MODEL_PROVIDER=ollama
CHAT_MODEL=qwen3-14b-16k
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- OpenAI embeddings (needed from ingestion onward, and for CHAT_MODEL_PROVIDER=openai) ---

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
