# Local development uses the Supabase stack from `supabase start` (run from the repo root).
# `supabase status -o env` prints the local values. For hosted Supabase:
#   Dashboard -> Project Settings -> API, and Project Settings -> Database -> Connection string.

# --- Supabase (Auth + API) ---

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: use the DIRECT connection (host: db.<ref>.supabase.co).
# Do NOT use the transaction pooler URL (pooler.supabase.com) - migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Models (OpenRouter, every environment) ---

# Create a key at https://openrouter.ai/keys and add credit. Never commit it.
OPENROUTER_API_KEY=

# Any OpenRouter model id with tool calling and structured outputs. Pin a dated version, not a ~latest alias.
CHAT_MODEL=deepseek/deepseek-v4-flash-0731

# Changing the embedding model means re-running ingestion. Dimensions must match the database column.
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_INPUT_TOKENS=8000
# Only for models that expect an instruction on questions (qwen3-embedding). bge-m3 takes none.
EMBEDDING_QUERY_INSTRUCTION=

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
